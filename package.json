{
  "name": "el-batta-el-meshmeshia",
  "displayName": "El-Batta El-Meshmeshia — Fake Senior Duck",
  "description": "A pixel-art senior duck that catches suspicious AI pastes, roasts you in Egyptian Arabic, and cleans the evidence.",
  "version": "1.1.0",
  "publisher": "asma-2005",
  "license": "MIT",
  "private": false,
  "icon": "images/icon.png",
  "banner": {
    "color": "#020618",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "ai",
    "paste",
    "cleanup",
    "egyptian",
    "arabic",
    "duck",
    "copilot",
    "chatgpt",
    "productivity"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:batta.duckView",
    "onCommand:batta.cleanAiJunk",
    "onCommand:batta.showStats",
    "onCommand:batta.toggle",
    "onCommand:batta.resetStats",
    "onCommand:batta.openDuck"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "batta-sidebar",
          "title": "El-Batta",
          "icon": "images/duck-activity.svg"
        }
      ]
    },
    "views": {
      "batta-sidebar": [
        {
          "type": "webview",
          "id": "batta.duckView",
          "name": "Fake Senior Duck",
          "contextualTitle": "El-Batta"
        }
      ]
    },
    "commands": [
      {
        "command": "batta.openDuck",
        "title": "El-Batta: Open Duck Sidebar",
        "category": "El-Batta"
      },
      {
        "command": "batta.cleanAiJunk",
        "title": "El-Batta: Clean AI Junk",
        "category": "El-Batta"
      },
      {
        "command": "batta.showStats",
        "title": "El-Batta: Show Duck Stats",
        "category": "El-Batta"
      },
      {
        "command": "batta.toggle",
        "title": "El-Batta: Toggle Paste Guard",
        "category": "El-Batta"
      },
      {
        "command": "batta.resetStats",
        "title": "El-Batta: Reset Duck Stats",
        "category": "El-Batta"
      }
    ],
    "configuration": {
      "title": "El-Batta El-Meshmeshia",
      "properties": {
        "batta.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Let El-Batta inspect suspicious pasted blocks. Everything stays local."
        },
        "batta.openSidebarOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Open the permanent pixel-duck sidebar when VS Code starts."
        },
        "batta.lineThreshold": {
          "type": "number",
          "default": 35,
          "minimum": 5,
          "maximum": 500,
          "scope": "window",
          "description": "Lines required for a medium paste warning. Huge pastes use twice this value."
        },
        "batta.blurDurationSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "scope": "window",
          "description": "Seconds suspicious pasted text stays blurred before El-Batta reveals it."
        },
        "batta.showRoastNotifications": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Also show a native warning notification. The sidebar speech bubble always updates."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p .",
    "watch": "tsc -watch -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "package": "npm run test && vsce package --no-dependencies --out el-batta-el-meshmeshia.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Asma-2005/el-batta-el-meshmeshia.git"
  },
  "homepage": "https://github.com/Asma-2005/el-batta-el-meshmeshia#readme",
  "bugs": {
    "url": "https://github.com/Asma-2005/el-batta-el-meshmeshia/issues"
  }
}
